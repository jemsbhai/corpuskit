* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.woff binary
*.woff2 binary
*.whl binary

# Unified diffs encode empty context lines as a single space, including at EOF.
vendor/accelerate/*.patch whitespace=-blank-at-eol,-blank-at-eof
