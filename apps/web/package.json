{
  "name": "@corpuskit/web",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "CorpusKit production web application",
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "start": "next start",
    "test": "vitest run --coverage",
    "test:auth": "vitest run --config vitest.auth.config.ts --coverage",
    "test:workbenches": "vitest run --config vitest.workbenches.config.ts --coverage",
    "test:watch": "vitest",
    "pretest:e2e": "next build && node scripts/prepare-standalone.mjs",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "next": "^16.3.5",
    "openid-client": "6.8.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "redis": "6.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
