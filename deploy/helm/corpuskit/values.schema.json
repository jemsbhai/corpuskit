{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "global", "images", "serviceAccounts", "database", "oidc", "temporal",
    "artifactStorage", "metrics", "api", "web", "dispatcher", "workers",
    "phoible", "migration", "maintenance", "ingress", "networkPolicy", "monitoring"
  ],
  "properties": {
    "nameOverride": {"type": "string", "maxLength": 40},
    "fullnameOverride": {"type": "string", "maxLength": 52},
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "logLevel", "imagePullSecrets", "nodeSelector", "podLabels", "podAnnotations"],
      "properties": {
        "environment": {"enum": ["staging", "production"]},
        "logLevel": {"enum": ["INFO", "WARNING", "ERROR", "CRITICAL"]},
        "imagePullSecrets": {
          "type": "array", "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name"],
            "properties": {"name": {"$ref": "#/definitions/dnsLabel"}}
          }
        },
        "nodeSelector": {"$ref": "#/definitions/linuxAmd64NodeSelector"},
        "podLabels": {"$ref": "#/definitions/podLabelMap"},
        "podAnnotations": {"$ref": "#/definitions/podAnnotationMap"}
      }
    },
    "images": {
      "type": "object", "additionalProperties": false,
      "required": ["api", "web", "workerBatch", "workerExternalProvider", "workerGpuInference", "workerGpuTraining", "pullPolicy"],
      "properties": {
        "api": {"$ref": "#/definitions/image"},
        "web": {"$ref": "#/definitions/image"},
        "workerBatch": {"$ref": "#/definitions/image"},
        "workerExternalProvider": {"$ref": "#/definitions/image"},
        "workerGpuInference": {"$ref": "#/definitions/image"},
        "workerGpuTraining": {"$ref": "#/definitions/image"},
        "pullPolicy": {"enum": ["IfNotPresent", "Always", "Never"]}
      }
    },
    "serviceAccounts": {
      "type": "object", "additionalProperties": false,
      "required": ["api", "web", "dispatcher", "workerBatch", "workerExternalProvider", "workerGpuInference", "workerGpuTraining", "migrator", "phoible", "maintenance", "telemetry"],
      "properties": {
        "api": {"$ref": "#/definitions/dnsLabel"}, "web": {"$ref": "#/definitions/dnsLabel"},
        "dispatcher": {"$ref": "#/definitions/dnsLabel"}, "workerBatch": {"$ref": "#/definitions/dnsLabel"},
        "workerExternalProvider": {"$ref": "#/definitions/dnsLabel"}, "workerGpuInference": {"$ref": "#/definitions/dnsLabel"},
        "workerGpuTraining": {"$ref": "#/definitions/dnsLabel"}, "migrator": {"$ref": "#/definitions/dnsLabel"},
        "phoible": {"$ref": "#/definitions/dnsLabel"}, "maintenance": {"$ref": "#/definitions/dnsLabel"},
        "telemetry": {"$ref": "#/definitions/dnsLabel"}
      }
    },
    "database": {
      "type": "object", "additionalProperties": false,
      "required": ["api", "dispatcher", "workerBatch", "workerExternalProvider", "workerGpuInference", "workerGpuTraining", "adoptionBatch", "adoptionExternalProvider", "adoptionGpuInference", "adoptionGpuTraining", "migrator", "maintenance", "port"],
      "properties": {
        "api": {"$ref": "#/definitions/secretKeyRef"},
        "dispatcher": {"$ref": "#/definitions/secretKeyRef"},
        "workerBatch": {"$ref": "#/definitions/secretKeyRef"},
        "workerExternalProvider": {"$ref": "#/definitions/secretKeyRef"},
        "workerGpuInference": {"$ref": "#/definitions/secretKeyRef"},
        "workerGpuTraining": {"$ref": "#/definitions/secretKeyRef"},
        "adoptionBatch": {"$ref": "#/definitions/secretKeyRef"},
        "adoptionExternalProvider": {"$ref": "#/definitions/secretKeyRef"},
        "adoptionGpuInference": {"$ref": "#/definitions/secretKeyRef"},
        "adoptionGpuTraining": {"$ref": "#/definitions/secretKeyRef"},
        "migrator": {"$ref": "#/definitions/secretKeyRef"},
        "maintenance": {"$ref": "#/definitions/secretKeyRef"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "oidc": {
      "type": "object", "additionalProperties": false,
      "required": ["issuer", "audience", "clientId", "redirectUri", "scopes", "clientSecret"],
      "properties": {
        "issuer": {"$ref": "#/definitions/https443Url"},
        "audience": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,512}$"},
        "clientId": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,512}$"},
        "redirectUri": {"$ref": "#/definitions/https443Url"},
        "scopes": {"type": "string", "minLength": 1, "maxLength": 512},
        "clientSecret": {"$ref": "#/definitions/secretKeyRef"}
      }
    },
    "temporal": {
      "type": "object", "additionalProperties": false,
      "required": ["address", "namespace", "port", "tls", "credentials"],
      "properties": {
        "address": {"type": "string", "pattern": "^[A-Za-z0-9.-]+:[0-9]{1,5}$", "maxLength": 259},
        "namespace": {"type": "string", "minLength": 1, "maxLength": 128},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "tls": {"const": true},
        "credentials": {
          "type": "object", "additionalProperties": false,
          "required": ["api", "dispatcher", "workerBatch", "workerExternalProvider", "workerGpuInference", "workerGpuTraining"],
          "properties": {
            "api": {"$ref": "#/definitions/secretKeyRef"}, "dispatcher": {"$ref": "#/definitions/secretKeyRef"},
            "workerBatch": {"$ref": "#/definitions/secretKeyRef"}, "workerExternalProvider": {"$ref": "#/definitions/secretKeyRef"},
            "workerGpuInference": {"$ref": "#/definitions/secretKeyRef"}, "workerGpuTraining": {"$ref": "#/definitions/secretKeyRef"}
          }
        }
      }
    },
    "artifactStorage": {
      "type": "object", "additionalProperties": false,
      "required": ["endpoint", "bucket", "region", "pathStyle", "encryption", "kmsKeyId", "credentials"],
      "properties": {
        "endpoint": {"$ref": "#/definitions/https443Origin"},
        "bucket": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"},
        "region": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,63}$"},
        "pathStyle": {"type": "boolean"},
        "encryption": {"enum": ["AES256", "aws:kms"]},
        "kmsKeyId": {"$ref": "#/definitions/optionalSecretKeyRef"},
        "credentials": {
          "type": "object", "additionalProperties": false,
          "required": ["api", "workerBatch", "workerExternalProvider", "workerGpuInference", "workerGpuTraining", "maintenance"],
          "properties": {
            "api": {"$ref": "#/definitions/s3SecretRef"},
            "workerBatch": {"$ref": "#/definitions/s3SecretRef"},
            "workerExternalProvider": {"$ref": "#/definitions/s3SecretRef"},
            "workerGpuInference": {"$ref": "#/definitions/s3SecretRef"},
            "workerGpuTraining": {"$ref": "#/definitions/s3SecretRef"},
            "maintenance": {"$ref": "#/definitions/s3SecretRef"}
          }
        }
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false, "required": ["bearerToken"],
      "properties": {"bearerToken": {"$ref": "#/definitions/secretKeyRef"}}
    },
    "api": {
      "type": "object", "additionalProperties": false,
      "required": ["replicas", "allowedOrigins", "requiredCapabilities", "maxUploadBytes", "rateLimit", "resources", "autoscaling", "pdb"],
      "properties": {
        "replicas": {"type": "integer", "minimum": 2, "maximum": 100},
        "allowedOrigins": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/definitions/httpsUrl"}},
        "requiredCapabilities": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "maxUploadBytes": {"type": "integer", "minimum": 1, "maximum": 104857600},
        "rateLimit": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled", "windowSeconds", "readRequests", "writeRequests", "retentionWindows"],
          "properties": {
            "enabled": {"const": true},
            "windowSeconds": {"type": "integer", "minimum": 10, "maximum": 3600},
            "readRequests": {"type": "integer", "minimum": 10, "maximum": 100000},
            "writeRequests": {"type": "integer", "minimum": 1, "maximum": 10000},
            "retentionWindows": {"type": "integer", "minimum": 2, "maximum": 100}
          }
        },
        "resources": {"$ref": "#/definitions/resources"},
        "autoscaling": {"$ref": "#/definitions/autoscaling"},
        "pdb": {"$ref": "#/definitions/pdb"}
      }
    },
    "web": {
      "type": "object", "additionalProperties": false,
      "required": ["replicas", "allowedReturnPaths", "sessionRedis", "stateSecret", "sessionEncryptionKeys", "resources", "autoscaling", "pdb"],
      "properties": {
        "replicas": {"type": "integer", "minimum": 2, "maximum": 100},
        "allowedReturnPaths": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^/(?:[A-Za-z0-9._~-]+/?)*$", "not": {"pattern": "(^|/)\\.\\.?(/|$)"}, "maxLength": 128}},
        "sessionRedis": {"$ref": "#/definitions/secretKeyRef"},
        "stateSecret": {"$ref": "#/definitions/secretKeyRef"},
        "sessionEncryptionKeys": {"$ref": "#/definitions/secretKeyRef"},
        "resources": {"$ref": "#/definitions/resources"},
        "autoscaling": {"$ref": "#/definitions/autoscaling"},
        "pdb": {"$ref": "#/definitions/pdb"}
      }
    },
    "dispatcher": {
      "type": "object", "additionalProperties": false,
      "required": ["replicas", "batchSize", "pollSeconds", "resources", "pdb"],
      "properties": {
        "replicas": {"type": "integer", "minimum": 2, "maximum": 20},
        "batchSize": {"type": "integer", "minimum": 1, "maximum": 200},
        "pollSeconds": {"type": "number", "minimum": 0.05, "maximum": 30},
        "resources": {"$ref": "#/definitions/resources"},
        "pdb": {"$ref": "#/definitions/pdb"}
      }
    },
    "workers": {
      "type": "object", "additionalProperties": false,
      "required": ["common", "batch", "externalProvider", "gpuInference", "gpuTraining"],
      "properties": {
        "common": {
          "type": "object", "additionalProperties": false,
          "required": ["gracefulShutdownSeconds", "artifactMaxBytes", "modelCacheClaim", "datgIndexCacheClaim"],
          "properties": {
            "gracefulShutdownSeconds": {"type": "integer", "minimum": 1, "maximum": 300},
            "artifactMaxBytes": {"type": "integer", "minimum": 1, "maximum": 104857600},
            "modelCacheClaim": {"$ref": "#/definitions/dnsLabel"},
            "datgIndexCacheClaim": {"$ref": "#/definitions/dnsLabel"}
          }
        },
        "batch": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled", "replicas", "deadlineSeconds", "datgRuntimePolicies", "resources", "autoscaling", "pdb"],
          "properties": {
            "enabled": {"const": true}, "replicas": {"type": "integer", "minimum": 1, "maximum": 100},
            "deadlineSeconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400},
            "datgRuntimePolicies": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/definitions/datgPolicy"}},
            "resources": {"$ref": "#/definitions/resources"}, "autoscaling": {"$ref": "#/definitions/autoscaling"},
            "pdb": {"$ref": "#/definitions/pdb"}
          }
        },
        "externalProvider": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled", "replicas", "deadlineSeconds", "hostedModelPolicies", "huggingFaceRepositoryPolicies", "providerSecrets", "resources", "autoscaling", "pdb"],
          "properties": {
            "enabled": {"const": true}, "replicas": {"type": "integer", "minimum": 1, "maximum": 100},
            "deadlineSeconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400},
            "hostedModelPolicies": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/definitions/hostedPolicy"}},
            "huggingFaceRepositoryPolicies": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/definitions/huggingFaceRepositoryPolicy"}},
            "providerSecrets": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/definitions/providerSecret"}},
            "resources": {"$ref": "#/definitions/resources"}, "autoscaling": {"$ref": "#/definitions/autoscaling"},
            "pdb": {"$ref": "#/definitions/pdb"}
          }
        },
        "gpuInference": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled", "replicas", "deadlineSeconds", "localModelPolicies", "datgRuntimePolicies", "nodeSelector", "tolerations", "resources", "autoscaling", "pdb"],
          "properties": {
            "enabled": {"const": true}, "replicas": {"type": "integer", "minimum": 1, "maximum": 32},
            "deadlineSeconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400},
            "localModelPolicies": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/definitions/localPolicy"}},
            "datgRuntimePolicies": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/definitions/datgPolicy"}},
            "nodeSelector": {"$ref": "#/definitions/nonemptyStringMap"}, "tolerations": {"$ref": "#/definitions/tolerations"},
            "resources": {"$ref": "#/definitions/resources"}, "autoscaling": {"$ref": "#/definitions/autoscaling"},
            "pdb": {"$ref": "#/definitions/pdb"}
          }
        },
        "gpuTraining": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled", "replicas", "deadlineSeconds", "phonRlRuntimePolicies", "phonRlCacheRoots", "nodeSelector", "tolerations", "resources", "autoscaling", "pdb"],
          "properties": {
            "enabled": {"const": true}, "replicas": {"type": "integer", "minimum": 1, "maximum": 32},
            "deadlineSeconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400},
            "phonRlRuntimePolicies": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/definitions/phonRlPolicy"}},
            "phonRlCacheRoots": {"type": "object", "minProperties": 1, "maxProperties": 16, "additionalProperties": {"type": "string", "pattern": "^/models(?:/[A-Za-z0-9._/-]+)?$"}},
            "nodeSelector": {"$ref": "#/definitions/nonemptyStringMap"}, "tolerations": {"$ref": "#/definitions/tolerations"},
            "resources": {"$ref": "#/definitions/resources"}, "autoscaling": {"$ref": "#/definitions/autoscaling"},
            "pdb": {"$ref": "#/definitions/pdb"}
          }
        }
      }
    },
    "phoible": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "cacheClaim", "sourceClaim", "sourcePath", "timeoutSeconds", "jobTtlSeconds"],
      "properties": {
        "enabled": {"const": true}, "cacheClaim": {"$ref": "#/definitions/dnsLabel"},
        "sourceClaim": {"type": "string", "maxLength": 63},
        "sourcePath": {"type": "string", "pattern": "^/source/[A-Za-z0-9._/-]+$", "maxLength": 255},
        "timeoutSeconds": {"type": "number", "minimum": 1, "maximum": 300},
        "jobTtlSeconds": {"type": "integer", "minimum": 300, "maximum": 604800}
      }
    },
    "migration": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "jobTtlSeconds"],
      "properties": {"enabled": {"const": true}, "jobTtlSeconds": {"type": "integer", "minimum": 300, "maximum": 604800}}
    },
    "maintenance": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "schedule", "successfulJobsHistoryLimit", "failedJobsHistoryLimit", "limit", "maxReconciliationPages", "maxStagingPages", "resources"],
      "properties": {
        "enabled": {"const": true}, "schedule": {"type": "string", "minLength": 9, "maxLength": 100},
        "successfulJobsHistoryLimit": {"type": "integer", "minimum": 0, "maximum": 20},
        "failedJobsHistoryLimit": {"type": "integer", "minimum": 1, "maximum": 20},
        "limit": {"type": "integer", "minimum": 1, "maximum": 1000},
        "maxReconciliationPages": {"type": "integer", "minimum": 1, "maximum": 20},
        "maxStagingPages": {"type": "integer", "minimum": 1, "maximum": 20},
        "resources": {"$ref": "#/definitions/resources"}
      }
    },
    "ingress": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "className", "host", "tlsSecretName", "annotations"],
      "properties": {
        "enabled": {"const": true},
        "className": {"$ref": "#/definitions/dnsLabel"},
        "host": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$", "minLength": 1, "maxLength": 253},
        "tlsSecretName": {"$ref": "#/definitions/dnsLabel"},
        "annotations": {"$ref": "#/definitions/ingressAnnotationMap"}
      }
    },
    "networkPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "ports", "dns", "ingressController", "monitoring", "cidrs"],
      "properties": {
        "enabled": {"const": true},
        "ports": {"type": "object", "additionalProperties": false, "required": ["redis"], "properties": {"redis": {"type": "integer", "minimum": 1, "maximum": 65535}}},
        "dns": {"$ref": "#/definitions/peerSelectors"},
        "ingressController": {"$ref": "#/definitions/peerSelectors"},
        "monitoring": {"$ref": "#/definitions/peerSelectors"},
        "cidrs": {
          "type": "object", "additionalProperties": false,
          "required": ["database", "temporal", "artifactStorage", "redis", "oidc", "providers", "phoibleSource", "telemetryExporter"],
          "properties": {
            "database": {"$ref": "#/definitions/requiredCidrs"},
            "temporal": {"$ref": "#/definitions/requiredCidrs"},
            "artifactStorage": {"$ref": "#/definitions/requiredCidrs"},
            "redis": {"$ref": "#/definitions/requiredCidrs"},
            "oidc": {"$ref": "#/definitions/requiredCidrs"},
            "providers": {"$ref": "#/definitions/requiredCidrs"},
            "phoibleSource": {"$ref": "#/definitions/cidrs"},
            "telemetryExporter": {"$ref": "#/definitions/cidrs"}
          }
        }
      }
    },
    "monitoring": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "releaseLabel", "scrapeInterval", "scrapeTimeout", "contractAlertsEnabled", "dashboardEnabled", "runbookBaseUrl", "otelCollector"],
      "properties": {
        "enabled": {"const": true},
        "releaseLabel": {"type": "string", "minLength": 1, "maxLength": 63},
        "scrapeInterval": {"type": "string", "pattern": "^[1-9][0-9]*[smh]$"},
        "scrapeTimeout": {"type": "string", "pattern": "^[1-9][0-9]*[smh]$"},
        "contractAlertsEnabled": {"const": true},
        "dashboardEnabled": {"type": "boolean"},
        "runbookBaseUrl": {"$ref": "#/definitions/httpsUrl"},
        "otelCollector": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled", "image", "exporterEndpoint", "exporterAuthorization", "replicas", "resources"],
          "properties": {
            "enabled": {"type": "boolean"},
            "image": {"$ref": "#/definitions/optionalImage"},
            "exporterEndpoint": {"$ref": "#/definitions/optionalHttps443Url"},
            "exporterAuthorization": {"$ref": "#/definitions/optionalSecretKeyRef"},
            "replicas": {"type": "integer", "minimum": 2, "maximum": 20},
            "resources": {"$ref": "#/definitions/resources"}
          }
        }
      }
    }
  },
  "definitions": {
    "dnsLabel": {"type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$", "minLength": 1, "maxLength": 63},
    "stringMap": {"type": "object", "additionalProperties": {"type": "string"}},
    "podLabelMap": {
      "type": "object", "maxProperties": 64,
      "propertyNames": {"not": {"enum": ["app.kubernetes.io/name", "app.kubernetes.io/instance", "app.kubernetes.io/component", "app.kubernetes.io/managed-by", "app.kubernetes.io/version", "helm.sh/chart", "corpuskit.io/worker-profile"]}},
      "additionalProperties": {"type": "string", "maxLength": 63}
    },
    "podAnnotationMap": {
      "type": "object", "maxProperties": 64,
      "propertyNames": {"not": {"enum": ["checksum/config", "checksum/runtime-policy", "helm.sh/hook", "helm.sh/hook-weight", "helm.sh/hook-delete-policy"]}},
      "additionalProperties": {"type": "string", "maxLength": 8192}
    },
    "ingressAnnotationMap": {
      "type": "object", "maxProperties": 64,
      "propertyNames": {"not": {"enum": ["kubernetes.io/ingress.class", "nginx.ingress.kubernetes.io/ssl-redirect", "nginx.ingress.kubernetes.io/force-ssl-redirect", "nginx.ingress.kubernetes.io/proxy-body-size", "nginx.ingress.kubernetes.io/proxy-read-timeout"]}},
      "additionalProperties": {"type": "string", "maxLength": 8192}
    },
    "nonemptyStringMap": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 253}},
    "linuxAmd64NodeSelector": {
      "type": "object", "minProperties": 2, "maxProperties": 16,
      "required": ["kubernetes.io/os", "kubernetes.io/arch"],
      "properties": {
        "kubernetes.io/os": {"const": "linux"},
        "kubernetes.io/arch": {"const": "amd64"}
      },
      "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 253}
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "image": {
      "type": "object", "additionalProperties": false, "required": ["repository", "digest"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$", "minLength": 1, "maxLength": 255},
        "digest": {"$ref": "#/definitions/digest"}
      }
    },
    "optionalImage": {
      "type": "object", "additionalProperties": false, "required": ["repository", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1, "maxLength": 255},
        "digest": {"type": "string", "pattern": "^(?:|sha256:[0-9a-f]{64})$"}
      }
    },
    "secretKeyRef": {
      "type": "object", "additionalProperties": false, "required": ["secretName", "key"],
      "properties": {"secretName": {"$ref": "#/definitions/dnsLabel"}, "key": {"type": "string", "minLength": 1, "maxLength": 253}}
    },
    "optionalSecretKeyRef": {
      "type": "object", "additionalProperties": false, "required": ["secretName", "key", "optional"],
      "properties": {"secretName": {"type": "string", "maxLength": 63}, "key": {"type": "string", "minLength": 1, "maxLength": 253}, "optional": {"type": "boolean"}}
    },
    "s3SecretRef": {
      "type": "object", "additionalProperties": false, "required": ["secretName", "accessKey", "secretKey"],
      "properties": {"secretName": {"$ref": "#/definitions/dnsLabel"}, "accessKey": {"type": "string", "minLength": 1}, "secretKey": {"type": "string", "minLength": 1}}
    },
    "httpsUrl": {"type": "string", "pattern": "^https://[^/?#]+(?:/[^?#]*)?$", "maxLength": 2048},
    "https443Url": {"type": "string", "pattern": "^https://[A-Za-z0-9.-]+(?::443)?(?:/[^?#]*)?$", "maxLength": 2048},
    "https443Origin": {"type": "string", "pattern": "^https://[A-Za-z0-9.-]+(?::443)?/?$", "maxLength": 300},
    "optionalHttps443Url": {"type": "string", "pattern": "^(?:|https://[A-Za-z0-9.-]+(?::443)?(?:/[^?#]*)?)$", "maxLength": 2048},
    "providerSecret": {
      "type": "object", "additionalProperties": false, "required": ["name", "secretName", "key"],
      "properties": {
        "name": {"type": "string", "pattern": "^CORPUSKIT_PROVIDER_[A-Z0-9_]{1,43}$"},
        "secretName": {"$ref": "#/definitions/dnsLabel"},
        "key": {"type": "string", "minLength": 1, "maxLength": 253}
      }
    },
    "snapshotPin": {
      "type": "object", "additionalProperties": false, "required": ["repository_id", "revision", "snapshot_sha256"],
      "properties": {
        "repository_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "immutableModelPin": {
      "type": "object", "additionalProperties": false, "required": ["model", "revision"],
      "properties": {
        "model": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "hostedPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "model", "connection_id", "credential_ref", "input_cost_per_million_usd", "output_cost_per_million_usd", "max_output_tokens_per_request"],
      "properties": {
        "provider": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$"},
        "model": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"},
        "connection_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$"},
        "credential_ref": {"type": "object", "additionalProperties": false, "required": ["reference"], "properties": {"reference": {"type": "string", "pattern": "^secret://env/CORPUSKIT_PROVIDER_[A-Z0-9_]{1,43}$"}}},
        "input_cost_per_million_usd": {"type": "number", "minimum": 0, "maximum": 1000},
        "output_cost_per_million_usd": {"type": "number", "minimum": 0, "maximum": 1000},
        "max_output_tokens_per_request": {"type": "integer", "minimum": 1, "maximum": 32768},
        "request_delay_seconds": {"type": "number", "minimum": 0, "maximum": 30, "default": 0},
        "prompt_templates": {"type": "array", "maxItems": 16, "items": {"$ref": "#/definitions/hostedPromptTemplatePolicy"}}
      }
    },
    "hostedPromptTemplatePolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["template_id", "template_ref", "sha256", "size_bytes", "max_rendered_bytes"],
      "properties": {
        "template_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$"},
        "template_ref": {"type": "object", "additionalProperties": false, "required": ["reference"], "properties": {"reference": {"type": "string", "pattern": "^secret://env/CORPUSKIT_PROVIDER_[A-Z0-9_]{1,43}$"}}},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 8000},
        "max_rendered_bytes": {"type": "integer", "minimum": 1, "maximum": 100000}
      }
    },
    "huggingFaceRepositoryPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["dataset", "config", "split", "text_column", "revision", "language", "max_samples", "trust_remote_code"],
      "properties": {
        "dataset": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"},
        "config": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "split": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "text_column": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "language": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,31}$"},
        "max_samples": {"type": "integer", "minimum": 1, "maximum": 1000},
        "trust_remote_code": {"const": false}
      }
    },
    "localPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["pin", "artifact_sha256", "allowed_devices", "allowed_quantizations", "allow_phon_rl_adapters"],
      "properties": {
        "pin": {"$ref": "#/definitions/immutableModelPin"},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "allowed_devices": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["cpu", "cuda"]}},
        "allowed_quantizations": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["none", "4bit", "8bit"]}},
        "allow_phon_rl_adapters": {"type": "boolean"}
      }
    },
    "datgPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime_id", "model", "tokenizer", "allowed_quantizations"],
      "properties": {
        "runtime_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$"},
        "model": {"$ref": "#/definitions/snapshotPin"},
        "tokenizer": {"$ref": "#/definitions/snapshotPin"},
        "allowed_quantizations": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["none", "4bit", "8bit"]}}
      }
    },
    "phonRlPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime_id", "model", "tokenizer", "cache_root_id", "cache_mount_read_only", "allow_static_prompts", "allow_peft", "allowed_peft_ranks", "allowed_peft_alphas", "allowed_prompt_strategies"],
      "properties": {
        "runtime_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$"},
        "model": {"$ref": "#/definitions/snapshotPin"},
        "tokenizer": {"$ref": "#/definitions/snapshotPin"},
        "cache_root_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$"},
        "cache_mount_read_only": {"const": true}, "allow_static_prompts": {"type": "boolean"}, "allow_peft": {"type": "boolean"},
        "allowed_peft_ranks": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 256}},
        "allowed_peft_alphas": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 1024}},
        "allowed_prompt_strategies": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$"}}
      }
    },
    "resources": {
      "type": "object", "additionalProperties": false, "required": ["requests", "limits"],
      "properties": {
        "requests": {"type": "object", "required": ["cpu", "memory"], "additionalProperties": {"$ref": "#/definitions/quantity"}},
        "limits": {"type": "object", "required": ["cpu", "memory"], "additionalProperties": {"$ref": "#/definitions/quantity"}}
      }
    },
    "autoscaling": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "minReplicas", "maxReplicas", "cpuUtilization"],
      "properties": {
        "enabled": {"type": "boolean"}, "minReplicas": {"type": "integer", "minimum": 1},
        "maxReplicas": {"type": "integer", "minimum": 2}, "cpuUtilization": {"type": "integer", "minimum": 1, "maximum": 100},
        "memoryUtilization": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "pdb": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "minAvailable"],
      "properties": {"enabled": {"type": "boolean"}, "minAvailable": {"type": "integer", "minimum": 1}}
    },
    "peerSelectors": {
      "type": "object", "additionalProperties": false, "required": ["namespaceSelector", "podSelector"],
      "properties": {"namespaceSelector": {"$ref": "#/definitions/stringMap"}, "podSelector": {"$ref": "#/definitions/stringMap"}}
    },
    "quantity": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 32}, {"type": "integer", "minimum": 0}]},
    "tolerations": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["key", "operator", "effect"],
        "properties": {
          "key": {"type": "string", "minLength": 1, "maxLength": 253},
          "operator": {"enum": ["Exists", "Equal"]}, "value": {"type": "string", "maxLength": 63},
          "effect": {"enum": ["NoSchedule", "PreferNoSchedule", "NoExecute"]},
          "tolerationSeconds": {"type": "integer", "minimum": 0}
        }
      }
    },
    "cidrs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$"}},
    "requiredCidrs": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$"}}
  }
}
