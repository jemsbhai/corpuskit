# Runtime
# Staging/production require OIDC, PostgreSQL via asyncpg, exact HTTPS origins,
# Temporal with TLS, and the corpusgen-core readiness capability.
CORPUSKIT_ENVIRONMENT=development
# Exact process posture. Use api for corpuskit-api, dispatcher for
# corpuskit-dispatcher, worker for corpuskit-worker, and maintenance for
# corpuskit-maintenance. Each non-API entry point rejects the default api role.
CORPUSKIT_RUNTIME_ROLE=api
CORPUSKIT_AUTH_MODE=demo
CORPUSKIT_LOG_LEVEL=INFO
# Safe direct-install default. Container deployments set 0.0.0.0 explicitly and
# publish the port only through their intended loopback/ingress boundary.
CORPUSKIT_API_BIND_HOST=127.0.0.1
# Prometheus metrics are served at /internal/metrics. Staging and production
# require a distinct 32-512 character opaque bearer token.
CORPUSKIT_METRICS_ENABLED=true
# CORPUSKIT_METRICS_BEARER_TOKEN=<32-512-character-opaque-token>
# Authenticated, tenant-scoped fixed-window limits are shared through PostgreSQL.
# Staging/production API processes require this to remain enabled.
CORPUSKIT_API_RATE_LIMIT_ENABLED=false
CORPUSKIT_API_RATE_LIMIT_WINDOW_SECONDS=60
CORPUSKIT_API_RATE_LIMIT_READ_REQUESTS=600
CORPUSKIT_API_RATE_LIMIT_WRITE_REQUESTS=120
CORPUSKIT_API_RATE_LIMIT_RETENTION_WINDOWS=3
CORPUSKIT_DATABASE_URL=sqlite+aiosqlite:///./data/corpuskit.db
# Worker-only adoption authority. Deployed workers require a distinct,
# credential-bearing PostgreSQL service URL; never expose it to API/web processes.
# CORPUSKIT_ADOPTION_DATABASE_URL=postgresql+asyncpg://adoption-user:secret@db.example/corpuskit

# Immutable artifact storage. Filesystem is for local development only; staging and
# production require a fixed private HTTPS S3-compatible endpoint and SSE-S3/SSE-KMS.
CORPUSKIT_ARTIFACT_ROOT=./artifacts
CORPUSKIT_ARTIFACT_BACKEND=filesystem
CORPUSKIT_ARTIFACT_MAX_BYTES=10485760
CORPUSKIT_ARTIFACT_RETENTION_DAYS=30
CORPUSKIT_ARTIFACT_ORPHAN_GRACE_SECONDS=3600
CORPUSKIT_ARTIFACT_DOWNLOAD_CHUNK_BYTES=262144
CORPUSKIT_ARTIFACT_PRESIGN_SECONDS=300
CORPUSKIT_ARTIFACT_S3_BUCKET=corpuskit-artifacts
CORPUSKIT_ARTIFACT_S3_REGION=us-east-1
CORPUSKIT_ARTIFACT_S3_PATH_STYLE=false
CORPUSKIT_ARTIFACT_S3_CONNECT_TIMEOUT_SECONDS=3
CORPUSKIT_ARTIFACT_S3_READ_TIMEOUT_SECONDS=30
CORPUSKIT_ARTIFACT_S3_MAX_ATTEMPTS=3
# CORPUSKIT_ARTIFACT_S3_ENDPOINT=https://objects.example.com
# CORPUSKIT_ARTIFACT_S3_ACCESS_KEY_ID=
# CORPUSKIT_ARTIFACT_S3_SECRET_ACCESS_KEY=
# CORPUSKIT_ARTIFACT_S3_SESSION_TOKEN=
# CORPUSKIT_ARTIFACT_S3_SSE=AES256
# CORPUSKIT_ARTIFACT_S3_KMS_KEY_ID=

CORPUSKIT_ALLOWED_ORIGINS=["http://localhost:3000"]
CORPUSKIT_REQUIRED_CAPABILITIES=["corpusgen-core","phoible"]
CORPUSKIT_CAPABILITY_CACHE_SECONDS=60
CORPUSKIT_MAX_UPLOAD_BYTES=10485760
CORPUSKIT_MAX_SENTENCES_PER_IMPORT=10000
CORPUSKIT_MAX_SENTENCE_CHARACTERS=2000
CORPUSKIT_API_DOCS_ENABLED=true

# Run submission defaults to persistence only. Set temporal and start the dispatcher plus a
# compatible worker to execute queued runs.
CORPUSKIT_JOB_BACKEND=inline
CORPUSKIT_TEMPORAL_ADDRESS=localhost:7233
CORPUSKIT_TEMPORAL_NAMESPACE=default
CORPUSKIT_TEMPORAL_TASK_QUEUE=batch-cpu
# Staging/production require TLS. Set an API key only with TLS enabled.
CORPUSKIT_TEMPORAL_TLS=false
# CORPUSKIT_TEMPORAL_API_KEY=<provider-api-key>
CORPUSKIT_TEMPORAL_CONNECT_TIMEOUT_SECONDS=10
CORPUSKIT_TEMPORAL_ACTIVITY_HEARTBEAT_SECONDS=5
CORPUSKIT_TEMPORAL_MAX_CONCURRENT_ACTIVITIES=8
CORPUSKIT_WORKER_PROFILE=batch-cpu
CORPUSKIT_WORKER_GRACEFUL_SHUTDOWN_SECONDS=30
CORPUSKIT_WORKER_ACTIVITY_DEADLINE_CAP_SECONDS=300
# Required for deployed staging/production workers; use the immutable OCI digest,
# never a mutable tag. Development workers may leave it unset.
# CORPUSKIT_WORKER_IMAGE_DIGEST=sha256:<64-lowercase-hex>
# Exact server allowlists are JSON arrays of the typed policy DTOs. Empty arrays
# are default-deny. Secret values never belong in these JSON documents: hosted
# entries use only a secret://env/NAME reference and a public connection_id.
CORPUSKIT_WORKER_HOSTED_MODEL_POLICIES=[]
# Exact remote dataset/config/split/text-column/commit policies. The request's
# max_samples may be lower, never higher. Only external-provider workers download.
CORPUSKIT_WORKER_HUGGINGFACE_REPOSITORY_POLICIES=[]
CORPUSKIT_WORKER_LOCAL_MODEL_POLICIES=[]
CORPUSKIT_WORKER_DATG_RUNTIME_POLICIES=[]
CORPUSKIT_WORKER_PHON_RL_RUNTIME_POLICIES=[]
# Model and consumer index roots must be absolute read-only mounts in the container.
# The batch-only publication root is the writable view of that same DATG cache.
# CORPUSKIT_WORKER_MODEL_CACHE_ROOT=/models
CORPUSKIT_WORKER_MODEL_CACHE_MOUNT_READ_ONLY=false
# CORPUSKIT_WORKER_DATG_MODEL_CACHE_ROOT=/models
# CORPUSKIT_WORKER_DATG_INDEX_CACHE_ROOT=/datg-indexes
# CORPUSKIT_WORKER_DATG_INDEX_PUBLISH_ROOT=/datg-index-publish
CORPUSKIT_WORKER_DATG_CACHE_MOUNT_READ_ONLY=false
CORPUSKIT_WORKER_PHON_RL_CACHE_ROOTS={}
# CORPUSKIT_DISPATCHER_ID=corpuskit-local-dispatcher
CORPUSKIT_DISPATCHER_BATCH_SIZE=20
CORPUSKIT_DISPATCHER_POLL_SECONDS=1

# Production OIDC. Required when CORPUSKIT_AUTH_MODE=oidc.
# CORPUSKIT_OIDC_ISSUER=https://identity.example.com/
# CORPUSKIT_OIDC_AUDIENCE=corpuskit-api
CORPUSKIT_OIDC_ALGORITHMS=["RS256"]
CORPUSKIT_OIDC_JWKS_CACHE_SECONDS=300
CORPUSKIT_OIDC_REFRESH_COOLDOWN_SECONDS=10
CORPUSKIT_OIDC_HTTP_TIMEOUT_SECONDS=5
CORPUSKIT_OIDC_CLOCK_SKEW_SECONDS=0
CORPUSKIT_OIDC_ORGANIZATION_CLAIM=org_id
CORPUSKIT_OIDC_ROLE_CLAIM=role

# Optional server-managed provider credentials. Never expose these to the web app.
# CORPUSKIT_PROVIDER_API_KEY=<provider-key>
# OPENAI_API_KEY=<provider-key>
# ANTHROPIC_API_KEY=<provider-key>

# Frontend server/BFF. This value is never exposed to browser JavaScript.
CORPUSKIT_API_INTERNAL_URL=http://127.0.0.1:8000/api/v1

# Browser authentication/BFF. The two example keys are deterministic and DEVELOPMENT-ONLY;
# generate independent secrets before any shared deployment. Production/staging require OIDC
# plus an authenticated rediss:// session store and do not fall back to process memory.
CORPUSKIT_WEB_AUTH_MODE=demo
CORPUSKIT_WEB_STATE_SECRET=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE
CORPUSKIT_WEB_SESSION_ENCRYPTION_KEYS=["AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI"]
CORPUSKIT_WEB_ALLOWED_RETURN_PATHS=["/","/projects","/evaluate","/analysis","/capabilities","/g2p","/inventory","/coverage","/selection","/generation","/advanced","/jobs","/artifacts"]
CORPUSKIT_WEB_SESSION_ABSOLUTE_SECONDS=28800
CORPUSKIT_WEB_SESSION_IDLE_SECONDS=1800
CORPUSKIT_WEB_TOKEN_REFRESH_BEFORE_SECONDS=60
CORPUSKIT_WEB_LOGIN_TRANSACTION_SECONDS=600
CORPUSKIT_WEB_OIDC_TIMEOUT_SECONDS=5
CORPUSKIT_WEB_REDIS_COMMAND_TIMEOUT_MS=2000
CORPUSKIT_WEB_REDIS_PREFIX=corpuskit:web
# CORPUSKIT_WEB_SESSION_REDIS_URL=rediss://sessions.example.com:6379/0
# CORPUSKIT_WEB_OIDC_CLIENT_ID=corpuskit-web
# CORPUSKIT_WEB_OIDC_CLIENT_SECRET=<confidential-client-secret>
# CORPUSKIT_WEB_OIDC_REDIRECT_URI=https://app.example.com/auth/callback
CORPUSKIT_WEB_OIDC_SCOPES=openid profile offline_access
